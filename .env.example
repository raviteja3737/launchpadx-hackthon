# ==============================================================================
# Cross-Sense AI+ Agentic Operations — Environment Variables & API Keys
# ==============================================================================
# Paste your API keys below.
# This file is ignored by Git to keep your credentials safe.

# ------------------------------------------------------------------------------
# 1. LIVEKIT WEBRTC SETTINGS (Real-Time Voice & Data Channel Stream)
# ------------------------------------------------------------------------------
# Get your project credentials from: https://cloud.livekit.io
# Format: wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI 3.1 LIVE AI
# ------------------------------------------------------------------------------
# Google Gemini API Key (for real-time agent reasoning & multimodal diagnostics)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Configured Gemini Live Model (Gemini 3.1 Live)
GEMINI_MODEL=gemini-3.1-flash-live

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (Resend)
# ------------------------------------------------------------------------------
# Get your key from: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Recipient email address for critical machine alerts
# Default: 257r1a6704@cmrtc.ac.in
ALERT_RECIPIENT_EMAIL=257r1a6704@cmrtc.ac.in

# Optional: If you are routing emails via Lovable Connector Gateway
LOVABLE_API_KEY=

# ------------------------------------------------------------------------------
# 4. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
VITE_APP_URL=http://localhost:3000
NODE_ENV=development
